{
  "manifest_version": 3,
  "name": "IG Writer Companion",
  "version": "0.1.0",
  "description": "Capture images and text from any webpage into Instagram draft posts in your IG Writer app.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "IG Writer",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
