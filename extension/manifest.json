{
  "manifest_version": 3,
  "name": "miinimal — Page Capture",
  "version": "0.2.0",
  "description": "Capture images and text from any webpage into draft posts in your miinimal scheduler.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "miinimal",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
